{
  // cnblogs.com/mspeer/p/12055962.html
  "editor.formatOnSave": false,
  "path-intellisense.mappings": {
    "@": "${workspaceRoot}/src"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    {
      "language": "vue",
      "autoFix": true
    },
    "html",
    "vue"
  ]
}
