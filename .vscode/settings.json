{
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 20000,
  "editor.formatOnSave": false,
  "path-intellisense.mappings": {
    "@": "${workspaceRoot}/src"
  },
  "eslint.enable": true,
  "eslint.quiet": false, // 安静模式忽略警告
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true,
    "source.fixAll.stylelint": true
  },
  "eslint.validate": [
    "javascript",
    "typescript",
    "html",
    "vue"
  ],
  "stylelint.enable": true,
  "stylelint.stylelintPath": "./node_modules/stylelint",
  // "stylelint.configOverrides": {
  //   "rules": {
  //     "order/properties-alphabetical-order": [false, { "disableFix": false }],
  //     // "declaration-block-no-shorthand-property-overrides": false
  //   }
  // },
  // "stylelint.syntax": [""],
  "stylelint.autoFix": true,
  // "vetur.format.defaultFormatter.scss": "prettier",
  // "vetur.format.defaultFormatter.css": "prettier",

  // "terminal.integrated.shellArgs.windows": [
  //   "-NoExit",
  //   "/c",
  //   "chcp 65001"
  // ],
  //  #让prettier使用eslint的代码格式进行校验
  "prettier.eslintIntegration": true
}
